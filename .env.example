# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio or OpenRouter).
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: Optional OpenRouter key for routing to Gemini models.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# MAPS_API_KEY: Required for Google Maps API integration.
MAPS_API_KEY=MY_MAPS_API_KEY

# OPENWEATHER_API_KEY: Required for live weather updates in destination detail sheets.
OPENWEATHER_API_KEY=MY_OPENWEATHER_API_KEY

# GEOAPIFY_API_KEY: Required for geocoding and address autocomplete lookup.
GEOAPIFY_API_KEY=MY_GEOAPIFY_API_KEY

